{
  "name": "graze",
  "version": "0.1.0",
  "private": true,
  "description": "GRAZE (General Rendezvous Assessment and Zone Evaluator) — satellite conjunction visualizer",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/conjunction-core",
    "packages/conjunction-web"
  ],
  "scripts": {
    "build": "npm run build:core && npm run data:fetch && npm run build:web",
    "build:core": "npm run build --workspace conjunction-core",
    "build:web": "npm run build --workspace conjunction-web",
    "data:fetch": "node scripts/fetch-socrates.mjs",
    "test": "npm run typecheck && vitest run",
    "dev": "npm run dev --workspace conjunction-web",
    "refresh:test-data": "node scripts/refresh-test-data.mjs",
    "verify:texture": "node scripts/verify-texture-registration.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
