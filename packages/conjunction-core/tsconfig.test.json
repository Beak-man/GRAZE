{
  // Typecheck-only config covering everything the build config cannot.
  //
  // tsconfig.json sets rootDir: "src" because it emits to dist/, which means
  // test/ and scripts/ are invisible to it — a required field added to an
  // exported interface used to fail at runtime in the test fixtures instead of
  // at compile time. This config widens rootDir and emits nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "test", "scripts"]
}
